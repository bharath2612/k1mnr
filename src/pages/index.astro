<!-- ================= FOOTER ================= -->

<script is:inline>
(function(){
  "use strict";
  var form = document.getElementById("rfqForm");
  if(!form) return;
  var status = document.getElementById("rfqStatus");
  var submit = document.getElementById("rfqSubmit");

  form.addEventListener("submit", function(e){
    e.preventDefault();
    if(!form.reportValidity()) return;

    var data = {};
    new FormData(form).forEach(function(v, k){ data[k] = v; });

    submit.disabled = true;
    status.className = "rfq-status";
    status.textContent = "Sending…";

    fetch("/api/rfq", {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify(data)
    }).then(function(res){
      return res.json().then(function(body){ return {ok: res.ok, body: body}; });
    }).then(function(r){
      if(r.ok){
        form.reset();
        status.classList.add("ok");
        status.textContent = "Received — we will come back to you within one business day.";
      } else {
        status.classList.add("err");
        var fields = r.body && r.body.fields;
        status.textContent = (fields && fields[Object.keys(fields)[0]]) ||
          (r.body && r.body.error) ||
          "Something went wrong. Please email or call us instead.";
        submit.disabled = false;
      }
    }).catch(function(){
      status.classList.add("err");
      status.textContent = "Network error — please email contact@k1mnr.com or call us.";
      submit.disabled = false;
    });
  });
})();
</script>
