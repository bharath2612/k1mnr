---
import Base from '../layouts/Base.astro';
import { ORGANIZATION_JSONLD, LOCALBUSINESS_JSONLD } from '../lib/organization';

// Homepage is fully prerendered at build time: it must never depend on
// Supabase being reachable.
export const prerender = true;
---

<Base
