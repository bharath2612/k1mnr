---
import { SITE_NAME, absoluteUrl } from '../lib/organization';

export interface Props {
  title: string;
  description: string;
  /** Site-root-relative path, e.g. "/insights/coal-outlook". */
  path: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  /** Extra JSON-LD blocks (BlogPosting, BreadcrumbList, …). */
  jsonld?: unknown[];
  keywords?: string;
}

const {
  title,
  description,
  path,
  image = '/assets/og.jpg',
  imageAlt = 'K One Minerals — Driving industrial continuity with predictable coal trading & logistics.',
  imageWidth = 1200,
  imageHeight = 630,
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  jsonld = [],
  keywords,
} = Astro.props;

const canonical = absoluteUrl(path);
const absImage = absoluteUrl(image);

/**
 * JSON-LD goes inside a raw <script> element, where HTML escaping does not
 * apply — a "</script>" inside any string value (a post title, an excerpt)
 * would terminate the tag and inject markup. Escaping "<" as < is valid
 * JSON, parses identically, and makes that impossible.
 */
const serializeJsonLd = (block: unknown) =>
  JSON.stringify(block).replace(/</g, '\\u003c');
---

<title>{title}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:image" content={absImage} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absImage} />

{
  jsonld.map((block) => (
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(block)} />
  ))
}
