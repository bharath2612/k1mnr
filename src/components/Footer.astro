---
/**
 * Ported verbatim from index.html:842-877, with the same two mechanical fixes
 * as Nav.astro plus the Industry Insights entry in the Explore column.
 * The <span id="year"> is still filled by SiteScripts.astro.
 *
 * Statutory identifiers (LLPIN/GSTIN/IEC) render from REGISTRATION once K One
 * supplies the values in organization.ts — nothing shows while they're empty.
 */
import { REGISTRATION } from '../lib/organization';
---

<footer>
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="brand" href="/">
          <img class="brand-logo" src="/assets/logo.png" alt="K One Minerals logo">
          <span class="brand-name"><b>K One Minerals</b><span>&amp; Natural Resources LLP</span></span>
        </a>
        <p>Securing high-grade thermal and metallurgical coal direct from tier-1 mines, with end-to-end port logistics for India's cement, steel and power industries.</p>
      </div>
      <div class="foot-col">
        <h4>Explore</h4>
        <ul>
          <li><a href="/#about">About Us</a></li>
          <li><a href="/#products">Products</a></li>
          <li><a href="/#industries">Industries We Serve</a></li>
          <li><a href="/#services">Procurement Services</a></li>
          <li><a href="/#process">Our Process</a></li>
          <li><a href="/insights">Industry Insights</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>Reach Us</h4>
        <ul>
          <li><a href="tel:+917780780999">+91 77807 80999</a></li>
          <li><a href="mailto:contact@k1mnr.com">contact@k1mnr.com</a></li>
          <li><a href="https://wa.me/917780780999" target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a href="https://www.linkedin.com/company/k-one-minerals-natural-resources-llp/" target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href="/#contact">Madhapur, Hyderabad, India</a></li>
        </ul>
      </div>
    </div>
    {REGISTRATION.length > 0 && (
      <p class="foot-legal">
        {REGISTRATION.map((r) => (
          <span>{r.label}: {r.value}</span>
        ))}
      </p>
    )}
    <div class="foot-base">
      <span>© <span id="year">2026</span> K One Minerals &amp; Natural Resources LLP</span>
      <span>Predictable coal trading. End-to-end logistics.</span>
    </div>
  </div>
</footer>
