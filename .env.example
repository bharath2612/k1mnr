# ---------------------------------------------------------------------------
# Supabase — public read path.
# Used server-side only (SSR); the browser never talks to Supabase directly.
# RLS restricts this key to published posts.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://oaejsmgpvwnrowhzpptf.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_..."

# ---------------------------------------------------------------------------
# Supabase — SERVER ONLY. Bypasses RLS entirely. Never expose to the client.
# Used exclusively by /api/studio/* route handlers.
# Dashboard -> Project Settings -> API Keys -> service_role
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ---------------------------------------------------------------------------
# /studio access.
#
#   STUDIO_PASSCODE — the shared passcode for the content team.
#     Generate high-entropy; do NOT choose something memorable. The threat here
#     is a forwarded link, and high entropy makes online guessing irrelevant:
#       openssl rand -base64 24
#
#   STUDIO_SECRET — HMAC key signing the studio session cookie, and the salt
#     for IP hashes in the audit log. Rotating it logs everyone out instantly:
#       openssl rand -base64 32
# ---------------------------------------------------------------------------
STUDIO_PASSCODE=""
STUDIO_SECRET=""

# ---------------------------------------------------------------------------
# Optional. Enables instant cache purge on publish instead of the 60s ISR
# window. Any random string; must be identical in Vercel's env and at build
# time (astro.config.mjs reads it to configure the adapter).
#   openssl rand -hex 16
# ---------------------------------------------------------------------------
VERCEL_BYPASS_TOKEN=""

# ---------------------------------------------------------------------------
# Optional. RFQ form email notifications via Resend (https://resend.com).
# Requires the k1mnr.com sending domain to be verified in Resend.
# Without it, enquiries are still persisted to rfq_enquiries — only the
# notification mail to contact@ and the auto-acknowledgement are skipped.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
